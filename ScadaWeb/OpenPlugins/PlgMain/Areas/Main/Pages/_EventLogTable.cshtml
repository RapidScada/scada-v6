@model PaginatedList<EventFormatted>
@{
    dynamic dict = Locale.GetDictionary(typeof(EventLogModel).FullName + ".EventLogTable");
}

@if (Model.Count > 0)
{
    <table id="tblEventLog" class="table table-striped table-hover text-nowrap">
        <thead>
            <tr>
                <th><input id="chkSelectAll" class="form-check-input" type="checkbox" value=""></th>
                <th>@dict.TimeCol</th>
                <th>@dict.ObjCol</th>
                <th>@dict.DevCol</th>
                <th>@dict.CnlCol</th>
                <th>@dict.DescrCol</th>
                <th>@dict.StatCol</th>
                <th>@dict.SevCol</th>
                <th>@dict.AckCol</th>
                <th>@dict.ActCol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ef in Model)
            {
                var colorExists = ef.GetMainColor(out var c);
                var borderColor = colorExists ? $"border-left-color: {c};" : null;
                var textColor = colorExists ? $"color: {c};" : null;
                <tr event-id="@ef.Id">
                    <td style="@borderColor"><input class="form-check-input" type="checkbox" value=""></td>
                    <td>@ef.Time</td>
                    <td>@ef.Obj</td>
                    <td>@ef.Dev</td>
                    <td>@ef.Cnl</td>
                    <td>@ef.Descr</td>
                    <td style="@textColor">@ef.Stat</td>
                    <td>@ef.Sev</td>
                    <td>@ef.Ack</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <pager id="pgrEventLog" asp-for="PageIndex" page-count="Model.PageCount" />
        <page-size id="psEventLog" asp-for="PageSize" />
    </div>
}
else
{
    <div class="alert alert-warning">@WebPhrases.NoData</div>
}
