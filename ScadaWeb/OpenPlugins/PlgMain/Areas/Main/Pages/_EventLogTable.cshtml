@model PaginatedList<EventFormatted>
@{
    dynamic dict = Locale.GetDictionary(typeof(EventLogModel).FullName + ".EventLogTable");
}

@if (Model.Count > 0)
{
    <table id="tblMain" class="table table-striped table-hover">
        <thead>
            <tr>
                <th><input id="chkSelectAll" class="form-check-input" type="checkbox" value=""></th>
                <th>@dict.TimeCol</th>
                <th>@dict.ObjCol</th>
                <th>@dict.DevCol</th>
                <th>@dict.CnlCol</th>
                <th>@dict.DescrCol</th>
                <th>@dict.SevCol</th>
                <th>@dict.AckCol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ef in Model)
            {
                var rowStyle = ef.GetMainColor(out var c) 
                    ? $"--bs-table-color: {c}; --bs-table-striped-color: {c}; --bs-table-hover-color: {c};"
                    : null;
                <tr event-id="0" style="@rowStyle">
                    <td><input class="form-check-input" type="checkbox" value=""></td>
                    <td>@ef.Time</td>
                    <td>@ef.Obj</td>
                    <td>@ef.Dev</td>
                    <td>@ef.Cnl</td>
                    <td>@ef.Descr</td>
                    <td>@ef.Sev</td>
                    <td>@ef.Ack</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <pager id="pgrMain" asp-for="PageIndex" page-count="Model.PageCount" />
        <page-size id="psMain" asp-for="PageSize" />
    </div>
}
else
{
    <div class="alert alert-warning">@WebPhrases.NoData</div>
}
