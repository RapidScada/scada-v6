@{
    dynamic dict = Locale.GetDictionary(typeof(MimicEditModel).FullName + ".PropertyModal");
}
<!-- Property modal -->
<div id="divPropertyModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-truncate">@dict.PageTitle</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmPropertyModal" spellcheck="false">
                    <div class="mb-3">
                        <label id="propertyModal_lblPropertyName" for="propertyModal_txtPropertyName" class="form-label">@dict.lblPropertyName</label>
                        <input type="text" id="propertyModal_txtPropertyName" class="form-control" autocomplete="off">
                    </div>
                    <div>
                        <span id="propertyModal_lblObjectProperties" class="form-label d-inline-block">@dict.lblObjectProperties</span>
                        <input type="text" id="propertyModal_txtObjectDisplayName" class="form-control" disabled readonly>
                        <div id="propertyModal_divObjectProperties" class="container-fluid border rounded">
                        </div>
                    </div>
                    <button type="submit" class="d-none">Submit</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="propertyModal_btnOK" class="btn btn-primary">@dict.btnOK</button>
                <button type="button" id="propertyModal_btnCancel" class="btn btn-secondary" data-bs-dismiss="modal">@dict.btnCancel</button>
            </div>
        </div>
    </div>
</div>
