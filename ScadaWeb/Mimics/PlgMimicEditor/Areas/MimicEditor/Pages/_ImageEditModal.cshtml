@{
    dynamic dict = Locale.GetDictionary(typeof(MimicEditModel).FullName + ".ImageEditModal");
}
<!-- Image edit modal -->
<div id="divImageEditModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-truncate">@dict.PageTitle</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmImageEditModal" class="needs-validation" novalidate spellcheck="false">
                    <div class="mb-3">
                        <label id="imageEditModal_lblName" for="imageEditModal_txtName" class="form-label">@dict.lblName</label>
                        <input type="text" id="imageEditModal_txtName" class="form-control" required autocomplete="off">
                        <div class="invalid-feedback">@dict.RequiredField</div>
                    </div>
                    <div>
                        <span id="imageEditModal_lblData" class="form-label d-inline-block">@dict.lblData</span>
                        <span id="imageEditModal_spnFileSize"></span>
                        <div class="card text-center mb-3">
                            <div class="card-body">
                                <img id="imageEditModal_imgPreview" />
                                <div id="imageEditModal_divNoImage">@dict.NoImage</div>
                            </div>
                        </div>
                        <button type="button" id="imageEditModal_btnUpload" class="btn btn-outline-primary">@dict.btnUpload</button>
                        <a id="imageEditModal_btnDownload" class="btn btn-outline-primary">@dict.btnDownload</a>
                    </div>
                    <div class="d-none">
                        <input type="file" id="imageEditModal_file" />
                        <button type="submit">Submit</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="imageEditModal_btnOK" class="btn btn-primary">@dict.btnOK</button>
                <button type="button" id="imageEditModal_btnCancel" class="btn btn-secondary" data-bs-dismiss="modal">@dict.btnCancel</button>
            </div>
        </div>
    </div>
</div>
