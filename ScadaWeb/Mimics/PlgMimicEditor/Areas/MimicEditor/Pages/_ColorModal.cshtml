@{
    dynamic dict = Locale.GetDictionary(typeof(MimicEditModel).FullName + ".ColorModal");
}
<!-- Color modal -->
<div id="divColorModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5 text-truncate">@dict.PageTitle</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmColorModal" spellcheck="false">
                    <div class="mb-3">
                        <label id="colorModal_lblColor" for="colorModal_txtColor" class="form-label">@dict.lblColor</label>
                        <input type="text" id="colorModal_txtColor" class="form-control" autocomplete="off">
                    </div>
                    <div>
                        <span id="colorModal_lblKnownColors" class="form-label d-inline-block">@dict.lblKnownColors</span>
                        <div id="colorModal_divKnownColors" class="container-fluid border rounded">
                            <table id="colorModal_tblRecentColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thRecentColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblRedColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thRedColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblPinkColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thPinkColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblOrangeColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thOrangeColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblYellowColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thYellowColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblPurpleColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thPurpleColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblGreenColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thGreenColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblBlueColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thBlueColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblBrownColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thBrownColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblWhiteColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thWhiteColors</th></tr></thead>
                            </table>
                            <table id="colorModal_tblGrayColors" class="table table-hover table-borderless">
                                <thead><tr><th scope="col" colspan="3">@dict.thGrayColors</th></tr></thead>
                            </table>
                        </div>
                    </div>
                    <button type="submit" class="d-none">Submit</button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="colorModal_btnOK" class="btn btn-primary">@dict.btnOK</button>
                <button type="button" id="colorModal_btnCancel" class="btn btn-secondary" data-bs-dismiss="modal">@dict.btnCancel</button>
            </div>
        </div>
    </div>
</div>
